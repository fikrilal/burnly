{
  "schemaVersion": 1,
  "artifactNameTemplate": "burnly-v{version}-{platform}-{architecture}.{extension}",
  "targets": [
    {
      "rustTargetTriple": "aarch64-apple-darwin",
      "platform": "macos",
      "architecture": "aarch64",
      "bundles": [
        { "kind": "dmg", "extension": "dmg" },
        { "kind": "app", "extension": "app.tar.gz" }
      ]
    },
    {
      "rustTargetTriple": "x86_64-apple-darwin",
      "platform": "macos",
      "architecture": "x86_64",
      "bundles": [
        { "kind": "dmg", "extension": "dmg" },
        { "kind": "app", "extension": "app.tar.gz" }
      ]
    },
    {
      "rustTargetTriple": "aarch64-pc-windows-msvc",
      "platform": "windows",
      "architecture": "aarch64",
      "bundles": [{ "kind": "nsis", "extension": "exe" }]
    },
    {
      "rustTargetTriple": "x86_64-pc-windows-msvc",
      "platform": "windows",
      "architecture": "x86_64",
      "bundles": [{ "kind": "nsis", "extension": "exe" }]
    },
    {
      "rustTargetTriple": "aarch64-unknown-linux-gnu",
      "platform": "linux",
      "architecture": "aarch64",
      "bundles": [{ "kind": "appimage", "extension": "AppImage" }]
    },
    {
      "rustTargetTriple": "x86_64-unknown-linux-gnu",
      "platform": "linux",
      "architecture": "x86_64",
      "bundles": [{ "kind": "appimage", "extension": "AppImage" }]
    }
  ]
}
