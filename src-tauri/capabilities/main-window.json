{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Least-privilege capability for the local Burnly dashboard.",
  "remote": {
    "urls": [
      "http://localhost:1420/*",
      "http://127.0.0.1:1420/*",
      "tauri://localhost/*",
      "http://tauri.localhost/*"
    ]
  },
  "windows": ["main", "tray-panel"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow---burnly-contract-probe",
    "allow-app-get-bootstrap",
    "allow-app-get-capabilities",
    "allow-app-hide-tray-panel",
    "allow-settings-get",
    "allow-settings-update",
    "allow-refresh-get-state",
    "allow-refresh-request",
    "allow-refresh-cancel",
    "allow-usage-get-tray-summary"
  ]
}
