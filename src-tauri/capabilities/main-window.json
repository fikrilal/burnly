{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Least-privilege capability for the local Burnly dashboard.",
  "windows": ["main", "tray-panel"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow---burnly-contract-probe",
    "allow-app-get-bootstrap",
    "allow-app-get-capabilities",
    "allow-app-open-details",
    "allow-app-hide-tray-panel",
    "allow-diagnostics-get-status",
    "allow-diagnostics-get-history",
    "allow-diagnostics-reveal-logs",
    "allow-database-get-maintenance-status",
    "allow-database-integrity-check",
    "allow-database-checkpoint",
    "allow-database-vacuum",
    "allow-database-restore-migration-backup",
    "allow-history-get-export-preview",
    "allow-history-export",
    "allow-history-get-delete-preview",
    "allow-history-delete",
    "allow-settings-get",
    "allow-settings-update",
    "allow-settings-update-project-path-retention",
    "allow-budgets-list",
    "allow-budgets-get",
    "allow-budgets-create",
    "allow-budgets-update",
    "allow-budgets-enable",
    "allow-budgets-disable",
    "allow-budgets-delete",
    "allow-budgets-get-progress",
    "allow-refresh-get-state",
    "allow-refresh-request",
    "allow-refresh-cancel",
    "allow-usage-get-overview",
    "allow-usage-get-tray-summary",
    "allow-usage-get-calendar",
    "allow-usage-get-day-detail",
    "allow-usage-get-sessions",
    "allow-usage-get-session-detail"
  ]
}
