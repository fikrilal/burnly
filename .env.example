# Burnly desktop local overrides (optional).
# Copy to `.env` or `.env.local` and adjust. Loaded by `pnpm tauri` / `pnpm tauri dev`.
# These are local development overrides; omit this file to use production defaults.

# burnly-api origin (no trailing slash)
BURNLY_API_BASE_URL=http://127.0.0.1:4000

# burnly-web origin for browser sign-in (no trailing slash)
BURNLY_WEB_ORIGIN=http://127.0.0.1:3000

# Exact desktop OAuth callback; must match API AUTH_DESKTOP_REDIRECT_URIS
BURNLY_DESKTOP_REDIRECT_URI=http://127.0.0.1:39201/callback

# Optional: real ccusage binary for collector dev (unset uses fixture fake in tauri dev)
# BURNLY_CCUSAGE_DEV_BINARY=
