{
  "name": "burnly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:fmt:write": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "deps:check": "pnpm install --frozen-lockfile --ignore-scripts",
    "contracts:generate": "node scripts/harness/check-contracts.mjs --generate-placeholder",
    "contracts:check": "node scripts/harness/check-contracts.mjs",
    "migrations:check": "node scripts/harness/check-migrations.mjs",
    "collectors:fixtures": "node scripts/harness/check-collectors-fixtures.mjs",
    "duplication:report": "jscpd src src-tauri/src --min-lines 8 --min-tokens 70 --reporters console --exit-code 0",
    "public-api:check": "node scripts/harness/check-public-api.mjs",
    "architecture:check": "node scripts/harness/check-architecture.mjs",
    "harness:check": "pnpm architecture:check && pnpm public-api:check && pnpm contracts:check && pnpm migrations:check && pnpm collectors:fixtures && pnpm duplication:report",
    "evidence:desktop": "node scripts/harness/desktop-evidence.mjs",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm rust:check && pnpm harness:check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test && pnpm harness:check",
    "verify:ci-local": "pnpm deps:check && pnpm verify"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-query": "^5.101.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "echarts": "^6.1.0",
    "lucide-react": "^1.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jscpd": "^5.0.9",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.8"
  }
}
