{
  "name": "burnly",
  "private": true,
  "version": "0.1.7",
  "description": "Local desktop app for AI coding-tool token usage.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "build:tauri": "pnpm sidecar:prepare && pnpm build",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:fmt:write": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:test:compile": "cargo test --manifest-path src-tauri/Cargo.toml --no-run",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "deps:check": "pnpm install --frozen-lockfile --ignore-scripts",
    "contracts:generate": "node scripts/harness/check-contracts.mjs --generate",
    "contracts:check": "node scripts/harness/check-contracts.mjs",
    "migrations:check": "node scripts/harness/check-migrations.mjs",
    "collectors:fixtures": "node scripts/harness/check-collectors-fixtures.mjs",
    "sidecar:prepare": "node scripts/prepare-ccusage-sidecar.mjs",
    "sidecar:check": "node scripts/prepare-ccusage-sidecar.mjs --check",
    "duplication:report": "jscpd src src-tauri/src --min-lines 8 --min-tokens 70 --reporters console --exit-code 0",
    "public-api:check": "node scripts/harness/check-public-api.mjs",
    "architecture:check": "node scripts/harness/check-architecture.mjs",
    "architecture:test": "node scripts/harness/check-architecture.mjs --self-test",
    "security:check": "node scripts/harness/check-release-security.mjs",
    "security:test": "node scripts/harness/check-release-security.mjs --self-test",
    "packaging:check": "node scripts/harness/check-release-packaging.mjs",
    "packaging:test": "node scripts/harness/check-release-packaging.mjs --self-test",
    "release-workflow:check": "node scripts/harness/check-release-workflows.mjs",
    "release-workflow:test": "node scripts/harness/check-release-workflows.mjs --self-test",
    "platform-behavior:check": "node scripts/harness/check-platform-behavior.mjs",
    "platform-behavior:test": "node scripts/harness/check-platform-behavior.mjs --self-test",
    "linux-smoke:deb": "node scripts/smoke-linux-deb.mjs",
    "linux-smoke:appimage": "node scripts/smoke-linux-appimage.mjs",
    "windows-smoke:exe": "node scripts/smoke-windows-exe.mjs",
    "macos-smoke:dmg": "node scripts/smoke-macos-dmg.mjs",
    "macos-smoke:updater": "node scripts/smoke-macos-updater-archive.mjs",
    "macos-updater:archive": "node scripts/create-macos-updater-archive.mjs",
    "windows-runtime:evidence:check": "node scripts/verify-windows-runtime-evidence.mjs",
    "release-artifacts:test": "node scripts/harness/check-release-artifact-tools.mjs",
    "release:artifacts": "node scripts/release-artifact-names.mjs",
    "release:version": "node scripts/check-release-version.mjs",
    "release:stage": "node scripts/stage-release-artifacts.mjs",
    "release:verify": "node scripts/verify-release-artifacts.mjs",
    "updater:manifest": "node scripts/generate-updater-manifest.mjs",
    "updater:verify": "node scripts/verify-updater-manifest.mjs",
    "updater-metadata:test": "node scripts/harness/check-updater-manifest-tools.mjs",
    "harness:check": "pnpm architecture:test && pnpm architecture:check && pnpm security:test && pnpm security:check && pnpm packaging:test && pnpm packaging:check && pnpm release-workflow:test && pnpm release-workflow:check && pnpm platform-behavior:test && pnpm platform-behavior:check && pnpm release-artifacts:test && pnpm updater-metadata:test && pnpm public-api:check && pnpm contracts:check && pnpm migrations:check && pnpm sidecar:check && pnpm collectors:fixtures && pnpm duplication:report",
    "evidence:desktop": "node scripts/harness/desktop-evidence.mjs",
    "verify:runtime": "pnpm evidence:desktop",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm sidecar:prepare && pnpm rust:check && pnpm harness:check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm sidecar:prepare && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test && pnpm harness:check",
    "verify:windows": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm sidecar:prepare && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test:compile && pnpm harness:check",
    "verify:ci-local": "pnpm deps:check && pnpm verify"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-query": "^5.101.0",
    "@tauri-apps/api": "^2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "12.42.0",
    "lucide-react": "^1.18.0",
    "motion": "12.42.0",
    "radix-ui": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "ccusage": "=20.0.14",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jscpd": "^5.0.9",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.8"
  }
}
